% Figure 2 : meme arbre, proximite et bonus relationnel hors diagonale.
\begingroup
\definecolor{fhNavy}{HTML}{17364A}
\definecolor{fhTeal}{HTML}{168C93}
\definecolor{fhGray}{HTML}{7A8791}
\begin{tikzpicture}[x=1cm,y=1cm,font=\sffamily,>=stealth,
  every node/.style={text=fhNavy},
  fhLabel/.style={font=\sffamily\small},
  fhNote/.style={font=\sffamily\footnotesize,text=fhGray,align=center},
  fhBranch/.style={line width=1.15pt,line cap=round}]
\path[use as bounding box] (0,0) rectangle (14,7.2);
\node[anchor=west,font=\sffamily\large\bfseries] at (0.25,6.8)
  {Une fusion précoce donne un bonus d'échange};
\node[fhLabel,font=\sffamily\small\bfseries] at (2.4,6.05) {Hiérarchie};
\node[fhLabel,font=\sffamily\small\bfseries] at (6.5,6.05) {Proximité};
\node[fhLabel,font=\sffamily\small\bfseries] at (11.1,6.05) {Biais $B_H$};

\draw[fhBranch,fhTeal] (0.85,2.1) -- (0.85,2.7) -- (1.95,2.7) -- (1.95,2.1);
\draw[fhBranch,fhTeal] (1.4,2.7) -- (1.4,4.8);
\draw[fhBranch,fhGray] (3.05,2.1) -- (3.05,3.3) -- (4.15,3.3) -- (4.15,2.1);
\draw[fhBranch,fhGray] (3.6,3.3) -- (3.6,4.8);
\draw[fhBranch,fhNavy] (1.4,4.8) -- (3.6,4.8);
\node[anchor=south,font=\sffamily\footnotesize] at (2.5,4.9) {$0{,}9$};
\node[anchor=south,font=\sffamily\footnotesize,text=fhTeal] at (0.85,2.78) {$0{,}2$};
\node[anchor=south,font=\sffamily\footnotesize,text=fhGray] at (3.05,3.38) {$0{,}4$};
\foreach \x/\name/\colour in {0.85/A/fhTeal,1.95/B/fhTeal,3.05/C/fhGray,4.15/D/fhGray}
  \node[font=\sffamily\bfseries,text=\colour] at (\x,1.75) {\name};
\node[fhNote] at (2.5,1.08) {$u_{ij}$ : hauteur de fusion};

\draw[->,line width=1.1pt,fhGray] (4.6,3.65) -- (5.15,3.65);
\node[font=\sffamily\large,text=fhTeal] at (6.5,4.15) {$\kappa_{ij}=1-u_{ij}$};
\node[fhNote,text=fhNavy] at (6.5,3.15)
  {Fusion précoce\\$\Downarrow$\\Bonus fort};
\draw[->,line width=1.1pt,fhGray] (7.9,3.65) -- (8.5,3.65);

\foreach \row/\name in {0/A,1/B,2/C,3/D} {
  \node[font=\sffamily\bfseries] at (9.3+0.85*\row,5.65) {\name};
  \node[font=\sffamily\bfseries] at (8.72,4.98-0.85*\row) {\name};
}
\foreach \row/\col/\value/\shade/\ink in {
  0/0/0/5/fhGray,0/1/{0{,}8}/85/white,0/2/{0{,}1}/12/fhNavy,0/3/{0{,}1}/12/fhNavy,
  1/0/{0{,}8}/85/white,1/1/0/5/fhGray,1/2/{0{,}1}/12/fhNavy,1/3/{0{,}1}/12/fhNavy,
  2/0/{0{,}1}/12/fhNavy,2/1/{0{,}1}/12/fhNavy,2/2/0/5/fhGray,2/3/{0{,}6}/55/fhNavy,
  3/0/{0{,}1}/12/fhNavy,3/1/{0{,}1}/12/fhNavy,3/2/{0{,}6}/55/fhNavy,3/3/0/5/fhGray} {
  \node[minimum width=0.79cm,minimum height=0.79cm,rounded corners=2pt,
    fill=fhTeal!\shade,text=\ink,font=\sffamily\small,inner sep=0pt]
    at (9.3+0.85*\col,4.98-0.85*\row) {$\value$};
}
\node[fhNote] at (10.58,1.7) {Diagonale neutralisée};
\node[fhNote,text=fhNavy] at (10.58,1.1) {Ici : un candidat par token};

\node[font=\sffamily\small,text=fhTeal] at (7,0.35)
  {Un bonus de contexte, pas une probabilité de fissure.};
\end{tikzpicture}
\endgroup
