% Figure 1 : eloignement dans l'image, proximite dans la hierarchie.
\begingroup
\definecolor{fhNavy}{HTML}{17364A}
\definecolor{fhTeal}{HTML}{168C93}
\definecolor{fhGray}{HTML}{7A8791}
\begin{tikzpicture}[x=1cm,y=1cm,font=\sffamily,>=stealth,
  every node/.style={text=fhNavy},
  fhLabel/.style={font=\sffamily\small},
  fhNote/.style={font=\sffamily\footnotesize,text=fhGray,align=center},
  fhBranch/.style={line width=1.15pt,line cap=round}]
\path[use as bounding box] (0,0) rectangle (14,7.2);
\node[anchor=west,font=\sffamily\large\bfseries] at (0.25,6.8)
  {Loin dans l'image, proches dans la hiérarchie};
\node[fhLabel,font=\sffamily\small\bfseries] at (3.35,6.1) {Quatre fragments candidats};
\node[fhLabel,font=\sffamily\small\bfseries] at (10.4,6.1) {Leur hauteur de fusion};

\draw[fhGray!35,rounded corners=5pt] (0.35,1.45) rectangle (6.4,5.75);
\draw[fhTeal!45,densely dashed,line width=0.9pt]
  (1.3,4.65) .. controls (2.8,4.9) and (3.5,3.3) .. (5.35,3.65);
\draw[fhTeal,line width=2.7pt,line cap=round]
  (0.65,4.5) .. controls (0.85,4.85) and (1.1,4.55) .. (1.45,4.7);
\draw[fhTeal,line width=2.7pt,line cap=round]
  (5.15,3.6) .. controls (5.5,3.7) and (5.65,3.5) .. (6.0,3.9);
\fill[fhTeal] (1.05,4.67) circle (2pt);
\fill[fhTeal] (5.55,3.68) circle (2pt);
\node[font=\sffamily\bfseries,text=fhTeal] at (1.05,5.1) {A};
\node[font=\sffamily\bfseries,text=fhTeal] at (5.55,4.18) {B};
\node[fhNote,text=fhTeal] at (3.3,5.05)
  {Chaîne de raccords\\compatibles};

\draw[fhGray,line width=2.2pt,line cap=round]
  (1.72,2.1) .. controls (1.9,2.45) and (2.15,2.2) .. (2.42,2.4);
\draw[fhGray,line width=2.2pt,line cap=round]
  (3.05,2.4) .. controls (3.32,2.6) and (3.5,2.3) .. (3.72,2.55);
\draw[fhGray!60,densely dashed] (2.42,2.4) -- (3.05,2.4);
\node[font=\sffamily\bfseries,text=fhGray] at (2.1,1.8) {C};
\node[font=\sffamily\bfseries,text=fhGray] at (3.4,1.8) {D};
\node[fhNote,align=left,anchor=west] at (4.25,2.3) {Autres\\fragments};

\draw[fhGray!55,->] (7.35,1.9) -- (7.35,5.7);
\foreach \y/\value in {1.9/0,2.66/{0{,}2},3.42/{0{,}4},5.32/{0{,}9}} {
  \draw[fhGray!55] (7.27,\y) -- (7.43,\y);
  \node[anchor=east,font=\sffamily\scriptsize,text=fhGray] at (7.22,\y) {$\value$};
}
\draw[fhGray!15,densely dotted] (7.45,5.32) -- (12.9,5.32);
\draw[fhBranch,fhTeal] (8.05,1.9) -- (8.05,2.66) -- (9.45,2.66) -- (9.45,1.9);
\draw[fhBranch,fhTeal] (8.75,2.66) -- (8.75,5.32);
\draw[fhBranch,fhGray] (11.05,1.9) -- (11.05,3.42) -- (12.45,3.42) -- (12.45,1.9);
\draw[fhBranch,fhGray] (11.75,3.42) -- (11.75,5.32);
\draw[fhBranch,fhNavy] (8.75,5.32) -- (11.75,5.32);
\foreach \x/\name/\colour in {8.05/A/fhTeal,9.45/B/fhTeal,11.05/C/fhGray,12.45/D/fhGray}
  \node[font=\sffamily\bfseries,text=\colour] at (\x,1.55) {\name};
\node[fhNote,text=fhTeal] at (8.75,2.25) {Fusion\\précoce};
\node[fhNote] at (10.35,5.65) {Fusion tardive};

\node[align=center,font=\sffamily\small] at (7,0.83)
  {La proximité dépend du raccord le moins favorable, pas de la longueur du chemin.};
\node[fhNote] at (7,0.3) {Exemple schématique : hauteurs illustratives, dans $[0,1]$.};
\end{tikzpicture}
\endgroup
