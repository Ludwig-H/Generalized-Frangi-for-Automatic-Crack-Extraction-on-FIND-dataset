% Gemini theme
% https://github.com/anishathalye/gemini

% ====================
% Definitions
% ====================

% \definecolor{lightgray}{RGB}{245, 246, 250}
% \definecolor{blue}{RGB}{64, 115, 158}
% \definecolor{darkblue}{RGB}{39, 60, 117}
% \definecolor{lightblue}{RGB}{232, 244, 255}

\definecolor{inriared}{RGB}{230,51,18}
\definecolor{inriagrayblue}{RGB}{56,66,87}
\definecolor{inriawhite}{RGB}{255,255,255}
\definecolor{inriayellow}{RGB}{255,205,28}
\definecolor{inriaorange}{RGB}{240,126,38}
\definecolor{inrialightgreen}{RGB}{199,214,79}
\definecolor{inriagreen}{RGB}{149,193,31}
\definecolor{inrialightblue}{RGB}{137,204,202}
\definecolor{inriablue}{RGB}{20,136,202}
\definecolor{inriamauve}{RGB}{101,97,169}
\definecolor{inrialilac}{RGB}{155,0,79}

% ====================
% Theme
% ====================

% Basic colors
\setbeamercolor{palette primary}{fg=black,bg=white}
\setbeamercolor{palette secondary}{fg=black,bg=white}
\setbeamercolor{palette tertiary}{bg=black,fg=white}
\setbeamercolor{palette quaternary}{fg=black,bg=white}
\setbeamercolor{structure}{fg=inriagrayblue}

% Headline
\setbeamercolor{headline}{fg=inriagrayblue!5,bg=inriagrayblue}
\setbeamercolor{headline rule}{bg=inriared}

% Block
% \setbeamercolor{block title}{fg=inriagrayblue,bg=white}
\setbeamercolor{block title}{fg=white,bg=inriagrayblue}
\setbeamercolor{block separator}{bg=black}
\setbeamercolor{block body}{fg=black,bg=inriagrayblue!5}

% Alert Block
% \setbeamercolor{block alerted title}{fg=inriared,bg=inriagrayblue!5}
\setbeamercolor{block alerted title}{fg=white,bg=inriared}
\setbeamercolor{block alerted separator}{bg=black}
\setbeamercolor{block alerted body}{fg=black,bg=inriared!5}

% Example Block
\setbeamercolor{block example title}{fg=inriared,bg=inriagrayblue!5}
\setbeamercolor{block example separator}{bg=black}
\setbeamercolor{block example body}{fg=black,bg=inriagrayblue!5}

% Heading
\setbeamercolor{heading}{fg=black}

% Itemize
\setbeamercolor{item}{fg=inriagrayblue}

% Bibliography
\setbeamercolor{bibliography item}{fg=black}
\setbeamercolor{bibliography entry author}{fg=black}
\setbeamercolor{bibliography entry title}{fg=black}
\setbeamercolor{bibliography entry location}{fg=black}
\setbeamercolor{bibliography entry note}{fg=black}
\setbeamertemplate{bibliography entry article}{}
\setbeamertemplate{bibliography entry title}{}
\setbeamertemplate{bibliography entry location}{}
\setbeamertemplate{bibliography entry note}{}
